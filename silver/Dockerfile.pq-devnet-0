# syntax=docker/dockerfile:1

ARG LEANVM_REV
FROM ghcr.io/ethpandaops/leanvm-sidecar:${LEANVM_REV} AS sidecar

# Follows the source repository's own Dockerfile: `blst`, `hashtree-rs` and
# `mimalloc` compile C, and both `build.rs` scripts shell out to `buf`.
FROM rust:1.91-bookworm AS build
ARG TARGETARCH
ARG BUF_VERSION=1.67.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends clang \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL -o /usr/local/bin/buf \
      "https://github.com/bufbuild/buf/releases/download/v${BUF_VERSION}/buf-Linux-$(uname -m)" \
    && chmod +x /usr/local/bin/buf
WORKDIR /silver
COPY . .
ARG COMMIT_HASH
RUN --mount=type=cache,id=pq-silver-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=pq-silver-target-${TARGETARCH},target=/silver/target \
    <<'EOF'
set -eu
case "$TARGETARCH" in
    amd64) target=x86_64-unknown-linux-gnu; optimized="-C target-cpu=x86-64-v3" ;;
    arm64) target=aarch64-unknown-linux-gnu; optimized="-C target-feature=+sha3" ;;
    *) echo "Unsupported target architecture: $TARGETARCH" >&2; exit 1 ;;
esac
build_profile() {
    profile=$1
    flags=$2
    SILVER_BUILD_COMMIT="$COMMIT_HASH" RUSTFLAGS="$flags" CARGO_TARGET_DIR="/silver/target/$profile" \
        cargo build --target "$target" --profile release-prod --locked --features silver/metrics --bin silver --bin silver_surfer
    install -D "/silver/target/$profile/$target/release-prod/silver" "/out/silver-$profile"
}
build_profile baseline ""
build_profile optimized "$optimized"
install "/silver/target/baseline/$target/release-prod/silver_surfer" /out/silver_surfer
EOF

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
ARG COMMIT_HASH
LABEL org.opencontainers.image.revision=$COMMIT_HASH
# Without this the tracing subscriber writes to rolling files under LOG_PATH,
# where `docker logs` never sees them.
ENV LOG_STDOUT=1
COPY --from=sidecar /usr/local/bin/leanvm-sidecar /usr/local/bin/leanvm-sidecar
COPY --from=sidecar /usr/local/lib/leanvm-sidecar /usr/local/lib/leanvm-sidecar
COPY --from=sidecar /usr/local/bin/leanvm-sidecar-run /usr/local/bin/leanvm-sidecar-run
COPY --from=build /out/silver-baseline /out/silver-optimized /usr/local/lib/silver/
COPY --from=build /out/silver_surfer /usr/local/bin/silver_surfer
COPY --chmod=755 <<'EOF' /usr/local/bin/silver
#!/bin/sh
set -eu

case "$(uname -m)" in
    x86_64) required="avx2 bmi1 bmi2 fma f16c movbe abm" ;;
    aarch64) required="sha3" ;;
    *) required=unsupported ;;
esac
cpu_flags=$(grep -m1 -E '^(flags|Features)' /proc/cpuinfo 2>/dev/null || true)
profile=optimized
for flag in $required; do
    case " ${cpu_flags#*:} " in
        *" $flag "*) ;;
        *) profile=baseline ;;
    esac
done
exec /usr/local/lib/silver/silver-$profile "$@"
EOF
COPY --chmod=755 <<'EOF' /usr/local/bin/silver-pq-bn
#!/bin/sh
exec leanvm-sidecar-run --leanvm-socket silver "$@"
EOF
ENTRYPOINT ["/usr/local/bin/silver-pq-bn"]
