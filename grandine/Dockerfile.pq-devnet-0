# Grandine for pq-devnet-0 (mainnet preset). The leanVM sidecar comes from the
# ethpandaops/leanvm-sidecar image of the revision Grandine pins in Cargo.toml, and Grandine's
# grandine-pq starts it and then Grandine on its socket.
ARG LEANVM_REV
FROM ghcr.io/ethpandaops/leanvm-sidecar:${LEANVM_REV} AS sidecar

FROM rust:1.100.0-bookworm AS builder
RUN apt-get clean && apt-get update && apt-get --yes upgrade && apt-get install --yes cmake libclang-dev
COPY . .
RUN scripts/build/release.sh

FROM ubuntu:latest
RUN apt-get clean && apt-get update && apt-get -y upgrade && apt-get install -y --no-install-recommends \
  libssl-dev \
  ca-certificates \
  curl \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*
COPY --from=builder /target/compact/grandine /usr/local/bin/grandine
COPY --from=sidecar /usr/local/bin/leanvm-sidecar /usr/local/bin/leanvm-sidecar
COPY --from=sidecar /usr/local/lib/leanvm-sidecar /usr/local/lib/leanvm-sidecar
COPY --chmod=755 scripts/pq/grandine-pq /usr/local/bin/grandine-pq

ENTRYPOINT ["grandine-pq"]
