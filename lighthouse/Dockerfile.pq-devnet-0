FROM rust:1.99.1-bookworm@sha256:e6f2cff35d0f309acf8433b4f05878ed77092602c5065cc81801177da0bb3a9c AS build-tools
RUN apt-get update && apt-get install -y --no-install-recommends clang cmake libclang-dev protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
ARG TARGETARCH

FROM build-tools AS lighthouse-builder
WORKDIR /lighthouse
COPY . .
ARG COMMIT_HASH
RUN --mount=type=cache,id=pq-lighthouse-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=pq-lighthouse-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=pq-lighthouse-target-${TARGETARCH},target=/lighthouse/target \
    test "$(git rev-parse HEAD)" = "$COMMIT_HASH" \
    && test -r scripts/local_testnet/pq-genesis/lighthouse-pq-bn \
    && if [ "$TARGETARCH" = arm64 ]; then export JEMALLOC_SYS_WITH_LG_PAGE=16; fi \
    && make FEATURES=spec-minimal,portable

FROM build-tools AS sidecar-builder
WORKDIR /leanvm
COPY leanvm-revision /leanvm-revision
RUN leanvm_rev="$(cat /leanvm-revision)" \
    && { test "${#leanvm_rev}" -eq 40 && printf '%s\n' "$leanvm_rev" | grep -Eq '^[0-9a-f]{40}$'; } \
    && git init -q \
    && git fetch -q --depth=1 https://github.com/leanEthereum/leanVM "$leanvm_rev" \
    && git checkout -q --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "$leanvm_rev"
RUN --mount=type=cache,id=pq-sidecar-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=pq-sidecar-target-${TARGETARCH},target=/leanvm/target \
    case "$TARGETARCH" in \
      arm64) export JEMALLOC_SYS_WITH_LG_PAGE=16; \
             export RUSTFLAGS="-C target-cpu=generic -C target-feature=+aes" ;; \
      amd64) export RUSTFLAGS="-C target-cpu=x86-64 -C target-feature=+ssse3,+pclmulqdq" ;; \
      *) echo "Unsupported leanVM target architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && cargo build --locked --release -p leanvm-sidecar --features experimental_prover \
    && install -D target/release/leanvm-sidecar /out/leanvm-sidecar \
    && git rev-parse HEAD > /out/leanvm-revision

FROM ubuntu:24.04@sha256:73b999393d07f2bf65a40373778a44dc9a6d54ad7718d29247d8ff9413c4d6a8
ARG COMMIT_HASH
LABEL org.opencontainers.image.revision=$COMMIT_HASH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3t64 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=lighthouse-builder /usr/local/cargo/bin/lighthouse /usr/local/bin/lighthouse
COPY --from=sidecar-builder /out/leanvm-sidecar /usr/local/bin/leanvm-sidecar
COPY --from=sidecar-builder /out/leanvm-revision /usr/local/share/lighthouse/leanvm-revision
COPY --chmod=755 scripts/local_testnet/pq-genesis/lighthouse-pq-bn /usr/local/bin/lighthouse-pq-bn
